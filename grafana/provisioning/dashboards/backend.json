{
  "id": null,
  "uid": "fastapi-backend",
  "title": "FastAPI Backend",
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "5s",
  "tags": ["fastapi", "backend", "python"],
  "panels": [

    {
      "type": "stat",
      "title": "Requests Total",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "type": "stat",
      "title": "Errors (4xx + 5xx)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[1m]))",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "time() - process_start_time_seconds",
          "refId": "A"
        }
      ],
      "id": 3,
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "center" }
    },

    {
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "refId": "A"
        }
      ],
      "id": 4,
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 }
    },

    {
      "type": "timeseries",
      "title": "Latency Histogram (95th percentile)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 }
    },

    {
      "type": "timeseries",
      "title": "Memory Usage (MB)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "process_resident_memory_bytes / 1024 / 1024",
          "refId": "A"
        }
      ],
      "id": 6,
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 }
    },

    {
      "type": "timeseries",
      "title": "CPU Usage (seconds)",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 }
    },

    {
      "type": "table",
      "title": "Requests by Method",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method)",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 }
    },

    {
      "type": "table",
      "title": "Requests by Status Code",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (status)",
          "refId": "A"
        }
      ],
      "id": 9,
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 }
    }

  ],

  "templating": {
    "list": []
  },

  "time": { "from": "now-1h", "to": "now" }
}
